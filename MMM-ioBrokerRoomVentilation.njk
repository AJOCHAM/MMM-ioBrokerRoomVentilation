
<div id="rooms-container">
  <div id="rooms">
    {% for room in rooms %}

      {# -------------------------------------------------------------------------------------------------- #}
      {# fenster öffnen --------------------------------------------------------------------------------#}
        {%  if room.humidity > 61 and not room.windowStatus and room.temperature >= room.outsideTemperature %}
                  <div class="room">
                    <div>
                      <h3>{{ room.name }}</h3>
                      {{ room.temperature }}°C
                      {% if room.humidity %} <br>{{ room.humidity }}% {% endif %}
                    </div>
                    <div class="image font-action" style="background-image: url('https://media0.giphy.com/media/v1.Y2lkPTc5MGI3NjExNjJuNWRsb2x3bWozb2FpZnc0N2FzaTBlcmNwc2xkMTZjdDIzOTFjdiZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/l4FATJpd4LWgeruTK/giphy.gif')" />
                      FENSTER ÖFFNEN
                    </div>
                  </div>
      {# -------------------------------------------------------------------------------------------------- #}
      {# lüftet --------------------------------------------------------------------------------#}
        {%  elif room.humidity >= 55 and room.windowStatus and room.temperature >= room.outsideTemperature %}
                  <div class="room">
                    <div>
                      <h3>{{ room.name }}</h3>
                      {{ room.temperature }}°C
                      {% if room.humidity %} <br>{{ room.humidity }}% {% endif %}
                    </div>
                    <div class="image font-action" style="background-image: url('https://media1.giphy.com/media/v1.Y2lkPTc5MGI3NjExZjh4aWljeGU5emV6cW1paXc1OW84M2lmbXlwZGRubDI3dzIxcjBhNyZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/7iLhuVVyhlX2UevY4z/giphy.gif')" />
                      {{ room.openDuration }} min
                    </div>
                  </div>
      {# -------------------------------------------------------------------------------------------------- #}
      {# Fenster schließen -------------------------------------------------------------------------------- #}
        {%  elif room.humidity < 55 and room.windowStatus and room.temperature >= room.outsideTemperature %}
                  <div class="room background-action">
                    <div>
                      <h3>{{ room.name }}</h3>
                      {{ room.temperature }}°C
                      {% if room.humidity %} <br>{{ room.humidity }}% {% endif %}
                    </div>
                    <div class="image font-action"
                      style="background-image: url('https://media0.giphy.com/media/v1.Y2lkPTc5MGI3NjExdXZwZzR1Y25ud2hxbXNtcmNzdGx4c2hsdDFsazA1NjU0bzl5NTdvdSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/BQpzJcROROj7cHNHxN/giphy.gif')" />
                      Fenster schließen<br>
                      {{ room.openDuration }} min
                    </div>
                  </div>
      {# -------------------------------------------------------------------------------------------------- #}
      {# lüftet --------------------------------------------------------------------------------#}
        {%  elif room.windowStatus and room.temperature <= room.outsideTemperature %}
                  <div class="room background-action">
                    <div>
                      <h3>{{ room.name }}</h3>
                      {{ room.temperature }}°C
                      {% if room.humidity %} <br>{{ room.humidity }}% {% endif %}
                    </div>
                    <div class="image font-action"
                      style="background-image: url('https://media1.giphy.com/media/v1.Y2lkPTc5MGI3NjExZjh4aWljeGU5emV6cW1paXc1OW84M2lmbXlwZGRubDI3dzIxcjBhNyZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/7iLhuVVyhlX2UevY4z/giphy.gif')" />
                      Fenster schließen<br>
                      {{ room.openDuration }} min
                    </div>
                  </div>  
      {# -------------------------------------------------------------------------------------------------- #}
      {# Fenster schließen --------------------------------------------------------------------------------#}
        {%  elif room.windowStatus and room.temperature >= room.outsideTemperature and room.openDuration > 15 %}
                  <div class="room background-action">
                    <div>
                      <h3>{{ room.name }}</h3>
                      {{ room.temperature }}°C
                      {% if room.humidity %} <br>{{ room.humidity }}% {% endif %}
                    </div>
                    <div class="image font-action"
                      style="background-image: url('https://media0.giphy.com/media/v1.Y2lkPTc5MGI3NjExdXZwZzR1Y25ud2hxbXNtcmNzdGx4c2hsdDFsazA1NjU0bzl5NTdvdSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/BQpzJcROROj7cHNHxN/giphy.gif')" />
                      Fenster schließen<br>
                      {{ room.openDuration }} min
                    </div>
                  </div>  
      {# -------------------------------------------------------------------------------------------------- #}
      {# NORMAL #}  
        {% else %}
                <div class="room">
                  <div>
                    <h3>{{ room.name }}</h3>
                    {{ room.temperature }}°C
                    {% if room.humidity %} <br>{{ room.humidity }}% {% endif %}
                  </div>
                </div>

        {% endif %}

  
    {% endfor %}
</div>
